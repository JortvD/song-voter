# Copy to .env and adjust. Compose reads this file automatically.

# --- General ---
APP_ENV=production
LOG_LEVEL=info
# Leave empty to use LOG_LEVEL; set to override, e.g. "ull_top2000_backend=debug,tower_http=debug"
RUST_LOG=

# Auth rate limits (per client IP)
AUTH_LOGIN_RATE_LIMIT=30
AUTH_REGISTER_RATE_LIMIT=40

# --- PostgreSQL (used by both the db container and the backend URL) ---
POSTGRES_DB=ulltop2000
POSTGRES_USER=ulltop2000
POSTGRES_PASSWORD=change-me
# Only needed when running the backend outside compose:
# DATABASE_URL=postgres://ulltop2000:change-me@localhost:5432/ulltop2000

# --- Auth (phase 1) ---
# Generate one with: openssl rand -hex 32
# If unset, an ephemeral dev secret is generated and sessions reset on restart.
JWT_SECRET=replace-with-64-random-hex-characters
JWT_TTL_HOURS=168
# Leave empty to default to Secure when APP_ENV=production.
# Set to false for local plain-HTTP testing (e.g. http://localhost:8080).
COOKIE_SECURE=
# First admin account, created on startup (promoted if it already exists).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Spotify (phase 2) ---
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match the Redirect URI added in the Spotify app dashboard exactly.
# Local testing: http://127.0.0.1:8080/api/admin/spotify/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/api/admin/spotify/callback
